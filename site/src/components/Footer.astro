---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/ghchinoy/share-with';

const links = [
  { label: 'Documentation', href: `${base}/getting-started/`, external: false },
  { label: 'Agent Plugin', href: `${base}/agent-plugin/`, external: false },
  { label: 'llms.txt', href: `${base}/llms.txt`, external: false },
  { label: 'drivectl', href: 'https://github.com/ghchinoy/drivectl', external: true },
  { label: 'Releases', href: `${repo}/releases`, external: true },
  { label: 'Apache 2.0', href: `${repo}/blob/main/LICENSE`, external: true },
];
---

<footer class="footer">
  <div class="wrap">
    <hr class="divider" />
    <div class="bar">
      <p class="legal muted">
        <span>share-with</span>
        <span class="sep" aria-hidden="true">&middot;</span>
        <span>Open-source silent Google Drive permission sharing CLI &amp; Agent Plugin</span>
      </p>
      <nav aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 0 28px;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 6px 24px;
    padding-block-start: 16px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font: var(--md-sys-typescale-label-md);
    font-weight: 400;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
    font: var(--md-sys-typescale-label-md);
    text-decoration: none;
    color: var(--md-sys-color-on-surface-variant);
  }

  li a:hover {
    color: var(--md-sys-color-on-surface);
    text-decoration: underline;
  }
</style>

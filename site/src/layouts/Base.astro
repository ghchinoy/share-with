---
import { Font } from 'astro:assets';

// gBreeze stylesheets from @material/web@2.5.0.
// m3.css comes first to establish the @layer cascade before our unlayered tokens.css.
import '@material/web/labs/gb/styles/m3.css';
import '@material/web/labs/gb/components/ripple/ripple.css';
import '@material/web/labs/gb/components/focus/focus-ring.css';
import '@material/web/labs/gb/components/button/button.css';
import '@material/web/labs/gb/components/iconbutton/icon-button.css';
import '@material/web/labs/gb/components/list/list.css';
import '@material/web/labs/gb/components/divider/divider.css';
import '@material/web/labs/gb/components/badge/badge.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1013" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="share-with" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
